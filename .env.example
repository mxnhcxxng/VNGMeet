# ──────────────────────────────────────────────────────────────────────────
# Azure AD App Registration (Microsoft Entra ID)
# Lấy ở: https://portal.azure.com → Microsoft Entra ID → App registrations
#   - CLIENT_ID     = "Application (client) ID"
#   - TENANT_ID     = "Directory (tenant) ID"  (hoặc "common" / "organizations")
#   - CLIENT_SECRET = Certificates & secrets → New client secret → copy "Value"
# ──────────────────────────────────────────────────────────────────────────
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=common

# Phải khớp với Redirect URI (type: Web) đã khai báo trong App registration.
REDIRECT_URI=http://localhost:8000/api/auth/callback
FRONTEND_URL=http://localhost:3000

# Khoá ký session cookie — đổi sang chuỗi ngẫu nhiên dài cho production.
SESSION_SECRET=change-me-in-production-please

# Cấu hình lưới hiển thị
TIMEZONE=Asia/Ho_Chi_Minh
BUSINESS_START_HOUR=8
BUSINESS_END_HOUR=18
SLOT_MINUTES=30

# Frontend gọi backend qua URL này (browser truy cập, nên là localhost khi chạy local)
NEXT_PUBLIC_API_URL=http://localhost:8000
