# ──────────────────────────────────────────────────────────────────────────
# Azure AD App Registration (Microsoft Entra ID)
# Cùng app bạn cấu hình làm Azure provider trong Supabase. Backend giữ creds này
# để đổi provider_refresh_token (Supabase trả về) lấy Graph access token mới.
#   - CLIENT_ID     = "Application (client) ID"
#   - TENANT_ID     = "Directory (tenant) ID"  (hoặc "common" / "organizations")
#   - CLIENT_SECRET = Certificates & secrets → New client secret → copy "Value"
# ──────────────────────────────────────────────────────────────────────────
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=common

# ──────────────────────────────────────────────────────────────────────────
# Supabase (Project Settings → API)
#   - SUPABASE_URL              = Project URL
#   - SUPABASE_ANON_KEY         = anon public key
#   - SUPABASE_SERVICE_ROLE_KEY = service_role key (BÍ MẬT — chỉ backend dùng)
#   - SUPABASE_JWT_SECRET       = JWT Settings → JWT Secret (verify session token)
# ──────────────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ──────────────────────────────────────────────────────────────────────────
# Chat bot LLM provider (OpenAI-compatible /chat/completions)
# ──────────────────────────────────────────────────────────────────────────
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-4-31b-it

# Backend chỉ redirect/CORS về frontend này.
FRONTEND_URL=http://localhost:3000

# Cấu hình lưới hiển thị
TIMEZONE=Asia/Ho_Chi_Minh
BUSINESS_START_HOUR=8
BUSINESS_END_HOUR=18
SLOT_MINUTES=30

# ──────────────────────────────────────────────────────────────────────────
# Frontend (Next.js) — đặt trong frontend/.env.local (xem frontend/.env.local.example)
# ──────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_API_URL=http://localhost:8000
